GEMINI_API_KEY=put-your-key-here
# סדר הגיבוי: הראשון נוסה קודם. מודל שנכשל (503/504/timeout) זז לסוף התור ל-2 דקות
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# תקרה לקריאה אחת ל-Gemini, בשניות (ברירת מחדל 40)
GEMINI_CALL_TIMEOUT=40
# כתובות פרונטאנד נוספות מופרדות בפסיקים (לדיפלוי בענן)
CORS_ORIGINS=https://your-app.onrender.com
# נתיב ה-DB (ברירת מחדל: backend/data/app.db)
DB_PATH=
# להגדיר 1 רק מאחורי פרוקסי של שירות האירוח
TRUST_PROXY=0
